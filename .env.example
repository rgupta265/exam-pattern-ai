# ==========================================
# ExamPattern AI — Environment Configuration
# ==========================================

# --- 1. Application ---
NODE_ENV=production
PORT=3000
APP_URL=https://aiexam.rupakgupta.com
NEXT_PUBLIC_APP_URL=https://aiexam.rupakgupta.com

# --- 2. MySQL Database (Separately Configured Properties) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=exampattern_ai
DB_USERNAME=exam_user
DB_PASSWORD=your_secure_mysql_password_here
# Optional SSL, Socket, and Connection Pool Settings
DB_SSL=false
DB_POOL_SIZE=10
# DB_SOCKET_PATH=/tmp/mysql.sock

# --- 3. Authentication & Sessions ---
# High-entropy secret key (min 32 characters)
AUTH_SECRET="change-to-a-secure-random-32-character-secret-in-production"
AUTH_EXPIRES_IN=7d

# --- 4. Google Gemini AI Engine (Server-Side Only) ---
GEMINI_API_KEY="your-google-gemini-api-key-here"

# --- 5. Storage (Local Filesystem Provider) ---
STORAGE_DRIVER=local
STORAGE_BASE_PATH="./storage"
# On production cPanel, point to private directory: /home/username/exam-pattern-storage
STORAGE_PATH="./storage"

# --- 6. Email & SMTP Configuration ---
# Provider options: "smtp", "console", "resend"
EMAIL_PROVIDER="smtp"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-smtp-app-password"
EMAIL_FROM="no-reply@exampattern.ai"
EMAIL_FROM_NAME="ExamPattern AI"

# --- 7. Upload Limits ---
MAX_UPLOAD_SIZE_MB=25

# --- 8. Internationalization / Locale ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi

# --- 9. Logging ---
LOG_LEVEL=info
