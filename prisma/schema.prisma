enum FileVisibility {
  PRIVATE
  PUBLIC
}

model File {
  id           String         @id @default(uuid()) @db.VarChar(36)
  originalName String         @map("original_name") @db.VarChar(255)
  storedName   String         @map("stored_name") @db.VarChar(255)
  storagePath  String         @map("storage_path") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  fileSize     BigInt         @map("file_size")
  checksumSha256 String       @map("checksum_sha256") @db.VarChar(64)
  visibility   FileVisibility @default(PRIVATE)
  folderCategory String       @map("folder_category") @db.VarChar(100) // "notifications", "question-assets", etc.
  createdAt    DateTime       @default(now()) @map("created_at")

  examDocuments ExamDocument[]
  practiceResources PracticeResource[]

  @@index([storagePath])
  @@index([checksumSha256])
  @@map("files")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String?  @map("user_id") @db.VarChar(36)
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.VarChar(36)
  ipAddress    String?  @map("ip_address") @db.VarChar(100)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  changesDiff  Json?    @map("changes_diff")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 9. CANDIDATE PRACTICE SYSTEM (ISOLATED)
// ==========================================

enum PracticeResourceType {
  DOCUMENT
  TEXT
  URL
  TOPIC
}

enum PracticeType {
  DOCUMENT_PRACTICE
  TEXT_PRACTICE
  URL_PRACTICE
  TOPIC_PRACTICE
  MIXED_PRACTICE
}

enum PracticeStatus {
  DRAFT
  GENERATING
  READY
  FAILED
  ARCHIVED
}

model PracticeResource {
  id               String               @id @default(uuid()) @db.VarChar(36)
  candidateId      String               @map("candidate_id") @db.VarChar(36)
  resourceType     PracticeResourceType @map("resource_type")
  title            String               @db.VarChar(191)
  fileId           String?              @map("file_id") @db.VarChar(36)
  fileType         String?              @map("file_type") @db.VarChar(50)
  rawText          String?              @map("raw_text") @db.LongText
  sourceUrl        String?              @map("source_url") @db.Text
  urlHostname      String?              @map("url_hostname") @db.VarChar(191)
  contentHash      String?              @map("content_hash") @db.VarChar(64)
  extractionStatus ProcessingStatus     @default(COMPLETED) @map("extraction_status")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  candidate        User                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  file             File?                @relation(fields: [fileId], references: [id], onDelete: SetNull)
  practiceTests    PracticeTest[]

  @@index([candidateId])
  @@index([resourceType])
  @@map("practice_resources")
}

model PracticeTest {
  id              String            @id @default(uuid()) @db.VarChar(36)
  code            String            @unique @db.VarChar(50) // e.g. "PRAC-8F72K"
  candidateId     String            @map("candidate_id") @db.VarChar(36)
  resourceId      String?           @map("resource_id") @db.VarChar(36)
  examVersionId   String?           @map("exam_version_id") @db.VarChar(36)
  title           String            @db.VarChar(191)
  practiceType    PracticeType      @default(TEXT_PRACTICE) @map("practice_type")
  generationMode  String            @default("SOURCE_ONLY") @map("generation_mode") @db.VarChar(50)
  totalQuestions  Int               @map("total_questions")
  durationMinutes Int               @map("duration_minutes")
  difficulty      DifficultyLevel   @default(MEDIUM)
  language        String            @default("English") @db.VarChar(20)
  status          PracticeStatus    @default(READY)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  candidate       User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resource        PracticeResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  examVersion     ExamVersion?      @relation(fields: [examVersionId], references: [id], onDelete: SetNull)
  questions       PracticeTestQuestion[]
  attempts        PracticeAttempt[]

  @@index([candidateId])
  @@index([resourceId])
  @@index([examVersionId])
  @@index([code])
  @@map("practice_tests")
}

model PracticeTestQuestion {
  id                String                 @id @default(uuid()) @db.VarChar(36)
  practiceTestId    String                 @map("practice_test_id") @db.VarChar(36)
  questionOrder     Int                    @map("question_order")
  questionText      String                 @map("question_text") @db.Text
  questionTextHindi String?                @map("question_text_hindi") @db.Text
  explanation       String?                @db.Text
  explanationHindi  String?                @map("explanation_hindi") @db.Text
  difficulty        DifficultyLevel        @default(MEDIUM)
  topic             String?                @db.VarChar(191)
  subtopic          String?                @db.VarChar(191)
  marks             Decimal                @default(1.0) @map("marks") @db.Decimal(5, 2)
  negativeMarks     Decimal                @default(0.0) @map("negative_marks") @db.Decimal(5, 2)
  createdAt         DateTime               @default(now()) @map("created_at")

  practiceTest      PracticeTest           @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  options           PracticeQuestionOption[]
  answers           PracticeAnswer[]

  @@unique([practiceTestId, questionOrder])
  @@index([practiceTestId])
  @@map("practice_test_questions")
}

model PracticeQuestionOption {
  id                String               @id @default(uuid()) @db.VarChar(36)
  questionId        String               @map("question_id") @db.VarChar(36)
  optionKey         String               @map("option_key") @db.VarChar(10) // "A", "B", "C", "D"
  optionText        String               @map("option_text") @db.Text
  optionTextHindi   String?              @map("option_text_hindi") @db.Text
  isCorrect         Boolean              @default(false) @map("is_correct")
  sortOrder         Int                  @default(0) @map("sort_order")

  question          PracticeTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedInAnswers PracticeAnswer[]

  @@index([questionId])
  @@map("practice_question_options")
}

model PracticeAttempt {
  id               String          @id @default(uuid()) @db.VarChar(36)
  candidateId      String          @map("candidate_id") @db.VarChar(36)
  practiceTestId   String          @map("practice_test_id") @db.VarChar(36)
  status           AttemptStatus   @default(IN_PROGRESS)
  startedAt        DateTime        @default(now()) @map("started_at")
  submittedAt      DateTime?       @map("submitted_at")
  totalTimeSpentSeconds Int        @default(0) @map("total_time_spent_seconds")
  lastHeartbeatAt  DateTime        @default(now()) @map("last_heartbeat_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  candidate        User            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  practiceTest     PracticeTest    @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  answers          PracticeAnswer[]
  result           PracticeResult?

  @@index([candidateId])
  @@index([practiceTestId])
  @@index([status])
  @@map("practice_attempts")
}

model PracticeAnswer {
  id               String                 @id @default(uuid()) @db.VarChar(36)
  attemptId        String                 @map("attempt_id") @db.VarChar(36)
  questionId       String                 @map("question_id") @db.VarChar(36)
  selectedOptionId String?                @map("selected_option_id") @db.VarChar(36)
  isAnswered       Boolean                @default(false) @map("is_answered")
  isMarkedForReview Boolean               @default(false) @map("is_marked_for_review")
  timeSpentSeconds Int                    @default(0) @map("time_spent_seconds")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  attempt          PracticeAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         PracticeTestQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   PracticeQuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("practice_answers")
}

model PracticeResult {
  id               String          @id @default(uuid()) @db.VarChar(36)
  attemptId        String          @unique @map("attempt_id") @db.VarChar(36)
  totalQuestions   Int             @map("total_questions")
  attemptedQuestions Int           @map("attempted_questions")
  correctAnswers   Int             @map("correct_answers")
  incorrectAnswers Int             @map("incorrect_answers")
  unattemptedQuestions Int         @map("unattempted_questions")
  score            Decimal         @map("score") @db.Decimal(8, 2)
  totalMarks       Decimal         @map("total_marks") @db.Decimal(8, 2)
  accuracyRate     Decimal         @map("accuracy_rate") @db.Decimal(5, 2)
  percentage       Decimal         @map("percentage") @db.Decimal(5, 2)
  geminiFeedback   String?         @map("gemini_feedback") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")

  attempt          PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("practice_results")
}

// ==========================================
// 10. APPLICATION TOUR VIDEOS
// ==========================================

enum TourVideoType {
  FULL_APPLICATION_TOUR
  CANDIDATE_END_TOUR
}

model ApplicationTourVideo {
  id              String        @id @default(uuid()) @db.VarChar(36)
  type            TourVideoType @default(FULL_APPLICATION_TOUR)
  title           String        @db.VarChar(191)
  description     String?       @db.Text
  fileName        String        @map("file_name") @db.VarChar(255)
  filePath        String        @map("file_path") @db.VarChar(500)
  mimeType        String        @map("mime_type") @db.VarChar(100)
  fileSize        Int           @map("file_size") // In bytes
  durationSeconds Int?          @map("duration_seconds")
  locale          String        @default("all") @db.VarChar(10) // "en", "hi", or "all"
  isPublished     Boolean       @default(false) @map("is_published")
  createdById     String?       @map("created_by_id") @db.VarChar(36)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  createdBy       User?         @relation("TourVideoCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([locale])
  @@index([isPublished])
  @@map("application_tour_videos")
}

// ==========================================
// 11. EMAIL & OTP AUTHENTICATION
// ==========================================

model EmailVerification {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String?   @map("user_id") @db.VarChar(36)
  email        String    @db.VarChar(191)
  otpHash      String    @map("otp_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  lastSentAt   DateTime  @default(now()) @map("last_sent_at")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

model PasswordResetOTP {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @map("user_id") @db.VarChar(36)
  email        String    @db.VarChar(191)
  otpHash      String    @map("otp_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  lastSentAt   DateTime  @default(now()) @map("last_sent_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_otps")
}

// ==========================================
// 12. CANDIDATE PROFILE, ADDRESS, EDUCATION & EXPERIENCE
// ==========================================

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model CandidateProfile {
  id                   String               @id @default(uuid()) @db.VarChar(36)
  userId               String               @unique @map("user_id") @db.VarChar(36)
  dateOfBirth          DateTime?            @map("date_of_birth")
  gender               Gender?              @default(PREFER_NOT_TO_SAY)
  alternativePhone     String?              @map("alternative_phone") @db.VarChar(50)
  bio                  String?              @db.Text
  completionPercentage Int                  @default(0) @map("completion_percentage")
  isSubmitted          Boolean              @default(false) @map("is_submitted")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  address              CandidateAddress?
  educations           CandidateEducation[]
  experiences          CandidateExperience[]

  @@index([userId])
  @@map("candidate_profiles")
}

model CandidateAddress {
  id           String           @id @default(uuid()) @db.VarChar(36)
  profileId    String           @unique @map("profile_id") @db.VarChar(36)
  addressLine1 String           @map("address_line_1") @db.VarChar(255)
  addressLine2 String?          @map("address_line_2") @db.VarChar(255)
  city         String           @db.VarChar(100)
  district     String?          @db.VarChar(100)
  state        String           @db.VarChar(100)
  postalCode   String           @map("postal_code") @db.VarChar(20)
  country      String           @default("India") @db.VarChar(100)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("candidate_addresses")
}

model CandidateEducation {
  id             String           @id @default(uuid()) @db.VarChar(36)
  profileId      String           @map("profile_id") @db.VarChar(36)
  qualification  String           @db.VarChar(150)
  institution    String           @db.VarChar(255)
  specialization String?          @db.VarChar(150)
  startYear      Int              @map("start_year")
  completionYear Int              @map("completion_year")
  gradeOrPercentage String?       @map("grade_or_percentage") @db.VarChar(50)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("candidate_educations")
}

model CandidateExperience {
  id             String           @id @default(uuid()) @db.VarChar(36)
  profileId      String           @map("profile_id") @db.VarChar(36)
  organization   String           @db.VarChar(255)
  jobTitle       String           @map("job_title") @db.VarChar(150)
  employmentType String           @default("Full-time") @map("employment_type") @db.VarChar(50)
  startDate      DateTime         @map("start_date")
  endDate        DateTime?        @map("end_date")
  isCurrent      Boolean          @default(false) @map("is_current")
  description    String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("candidate_experiences")
}

// ==========================================
// 12. DATABASE BACKUP & MAINTENANCE MODELS
// ==========================================

enum DatabaseBackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model DatabaseBackup {
  id           String               @id @default(uuid()) @db.VarChar(36)
  filename     String               @unique @db.VarChar(191)
  storagePath  String               @map("storage_path") @db.VarChar(500)
  sizeBytes    BigInt               @default(0) @map("size_bytes")
  databaseName String               @map("database_name") @db.VarChar(100)
  environment  String               @default("development") @db.VarChar(50)
  status       DatabaseBackupStatus @default(PENDING)
  errorMessage String?              @map("error_message") @db.Text
  tablesCount  Int                  @default(0) @map("tables_count")
  rowsCount    Int                  @default(0) @map("rows_count")
  createdById  String?              @map("created_by_id") @db.VarChar(36)
  completedAt  DateTime?            @map("completed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  createdBy    User?                @relation("BackupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([createdAt])
  @@map("database_backups")
}
