datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AUTH & RBAC MODELS
// ==========================================

enum UserRoleType {
  SUPER_ADMIN
  ADMIN
  QUESTION_REVIEWER
  CANDIDATE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id               String      @id @default(uuid()) @db.VarChar(36)
  email            String      @unique @db.VarChar(191)
  passwordHash     String      @map("password_hash") @db.VarChar(255)
  fullName         String      @map("full_name") @db.VarChar(191)
  phoneNumber      String?     @map("phone_number") @db.VarChar(50)
  avatarUrl        String?     @map("avatar_url") @db.VarChar(255)
  preferredLocale  String      @default("en") @map("preferred_locale") @db.VarChar(10)
  status           UserStatus  @default(ACTIVE)
  emailVerifiedAt  DateTime?   @map("email_verified_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")

  // Relations
  userRoles        UserRole[]
  candidateProfile CandidateProfile?
  emailVerifications EmailVerification[]
  passwordResetOtps  PasswordResetOTP[]
  auditLogs        AuditLog[]
  testAttempts     TestAttempt[]
  examStats        CandidateExamStatistic[]
  topicStats       CandidateTopicStatistic[]
  questionReviews  QuestionReview[]
  uploadedDocs     ExamDocument[]            @relation("DocumentUploader")
  verifiedDocs     ExamDocument[]            @relation("DocumentVerifier")
  verifiedBlueprints ExamBlueprint[]         @relation("BlueprintVerifier")
  lockedBlueprints   ExamBlueprint[]         @relation("BlueprintLocker")
  verifiedSyllabi    Syllabus[]              @relation("SyllabusVerifier")
  createdMockTests   MockTest[]              @relation("MockTestCreator")
  practiceResources  PracticeResource[]
  practiceTests      PracticeTest[]
  practiceAttempts   PracticeAttempt[]
  tourVideos         ApplicationTourVideo[]    @relation("TourVideoCreator")
  databaseBackups    DatabaseBackup[]          @relation("BackupCreator")

  @@index([email])
  @@index([status])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.VarChar(36)
  name            String           @unique @db.VarChar(100)
  code            UserRoleType     @unique
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(true) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.VarChar(36)
  code            String           @unique @db.VarChar(100)
  name            String           @db.VarChar(150)
  module          String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  roleId    String   @map("role_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.VarChar(36)
  roleId       String     @map("role_id") @db.VarChar(36)
  permissionId String     @map("permission_id") @db.VarChar(36)
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==========================================
// 2. EXAM & BLUEPRINT HIERARCHY
// ==========================================

model ExamCategory {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique @db.VarChar(150)
  slug        String    @unique @db.VarChar(150)
  description String?   @db.Text
  icon        String?   @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  exams       Exam[]

  @@map("exam_categories")
}

model Exam {
  id          String        @id @default(uuid()) @db.VarChar(36)
  categoryId  String        @map("category_id") @db.VarChar(36)
  name        String        @db.VarChar(191)
  slug        String        @unique @db.VarChar(150)
  code        String        @unique @db.VarChar(50)
  authority   String        @db.VarChar(191)
  postName    String        @map("post_name") @db.VarChar(191)
  description String?       @db.Text
  isFeatured  Boolean       @default(false) @map("is_featured")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  category    ExamCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions    ExamVersion[]

  @@index([categoryId])
  @@index([authority])
  @@index([postName])
  @@index([isActive])
  @@index([isFeatured])
  @@map("exams")
}

enum ExamVersionStatus {
  DRAFT
  PROCESSING
  UNDER_REVIEW
  VERIFIED
  ACTIVE
  ARCHIVED
}

model ExamVersion {
  id          String            @id @default(uuid()) @db.VarChar(36)
  examId      String            @map("exam_id") @db.VarChar(36)
  year        Int
  versionName String            @map("version_name") @db.VarChar(100) // e.g., "2026 Regular", "Corrigendum-1"
  notificationNumber String?    @map("notification_number") @db.VarChar(100)
  status      ExamVersionStatus @default(DRAFT)
  isActive    Boolean           @default(true) @map("is_active")
  effectiveDate DateTime?       @map("effective_date")
  description String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  exam        Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  documents   ExamDocument[]
  documentRequirements ExamDocumentRequirement[]
  blueprints  ExamBlueprint[]
  syllabi     Syllabus[]
  mockTests   MockTest[]
  stats       CandidateExamStatistic[]
  generationRequests MockGenerationRequest[]
  practiceTests PracticeTest[]

  @@unique([examId, versionName, year])
  @@index([examId])
  @@index([status])
  @@map("exam_versions")
}

enum DocumentType {
  OFFICIAL_NOTIFICATION
  ADVERTISEMENT
  DETAILED_NOTIFICATION
  SYLLABUS
  EXAM_PATTERN
  BLUEPRINT
  INSTRUCTIONS
  PREVIOUS_YEAR_PAPER
  ANSWER_KEY
  AMENDMENT
  CORRIGENDUM
  ELIGIBILITY
  SYLLABUS_DOCUMENT
  REFERENCE_MATERIAL
  NOTIFICATION
  OTHER
}

enum DocumentClassification {
  REQUIRED
  OPTIONAL
  REFERENCE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  VERIFIED
  REJECTED
  ARCHIVED
  FAILED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExamDocument {
  id           String                  @id @default(uuid()) @db.VarChar(36)
  examVersionId String                 @map("exam_version_id") @db.VarChar(36)
  fileId       String                  @map("file_id") @db.VarChar(36)
  documentType DocumentType            @default(NOTIFICATION) @map("document_type")
  documentCategory String?             @map("document_category") @db.VarChar(100)
  classification DocumentClassification @default(REQUIRED)
  status       DocumentStatus          @default(UPLOADED)
  title        String                  @db.VarChar(191)
  advertisementNumber String?          @map("advertisement_number") @db.VarChar(100)
  issueDate    DateTime?               @map("issue_date")
  sourceAuthority String?              @map("source_authority") @db.VarChar(191)
  extractedText String?                @map("extracted_text") @db.LongText
  verificationNotes String?            @map("verification_notes") @db.Text
  verifiedById String?                 @map("verified_by_id") @db.VarChar(36)
  verifiedAt   DateTime?               @map("verified_at")
  uploadedById String                  @map("uploaded_by_id") @db.VarChar(36)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  examVersion  ExamVersion             @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  file         File                    @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy   User                    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  verifiedBy   User?                   @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  jobs         DocumentProcessingJob[]

  @@index([examVersionId])
  @@index([fileId])
  @@index([documentType])
  @@index([status])
  @@map("exam_documents")
}

model ExamDocumentRequirement {
  id            String                 @id @default(uuid()) @db.VarChar(36)
  examVersionId String                 @map("exam_version_id") @db.VarChar(36)
  documentType  DocumentType           @map("document_type")
  classification DocumentClassification @default(REQUIRED)
  isMandatory   Boolean                @default(true) @map("is_mandatory")
  description   String?                @db.VarChar(255)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  examVersion   ExamVersion            @relation(fields: [examVersionId], references: [id], onDelete: Cascade)

  @@unique([examVersionId, documentType])
  @@index([examVersionId])
  @@map("exam_document_requirements")
}

model DocumentProcessingJob {
  id           String           @id @default(uuid()) @db.VarChar(36)
  documentId   String           @map("document_id") @db.VarChar(36)
  jobType      String           @map("job_type") @db.VarChar(100) // e.g., "PATTERN_EXTRACTION", "SYLLABUS_EXTRACTION"
  status       ProcessingStatus @default(PENDING)
  extractedData Json?           @map("extracted_data")
  errorMessage String?          @map("error_message") @db.Text
  startedAt    DateTime?        @map("started_at")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  document     ExamDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
  @@map("document_processing_jobs")
}

enum BlueprintStatus {
  DRAFT
  AI_ANALYZED
  UNDER_REVIEW
  VERIFIED
  LOCKED
  ACTIVE
}

model ExamBlueprint {
  id               String           @id @default(uuid()) @db.VarChar(36)
  examVersionId    String           @map("exam_version_id") @db.VarChar(36)
  versionNumber    Int              @default(1) @map("version_number")
  title            String           @db.VarChar(191)
  totalQuestions   Int              @map("total_questions")
  totalMarks       Decimal          @map("total_marks") @db.Decimal(8, 2)
  durationMinutes  Int              @map("duration_minutes")
  negativeMarkingRate Decimal       @default(0.0) @map("negative_marking_rate") @db.Decimal(5, 4) // e.g. 0.2500 for 1/4th
  hasNegativeMarking Boolean        @default(false) @map("has_negative_marking")
  status           BlueprintStatus  @default(DRAFT)
  verifiedById     String?          @map("verified_by_id") @db.VarChar(36)
  verifiedAt       DateTime?        @map("verified_at")
  lockedById       String?          @map("locked_by_id") @db.VarChar(36)
  lockedAt         DateTime?        @map("locked_at")
  instructions     String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  examVersion      ExamVersion      @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  verifiedBy       User?            @relation("BlueprintVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  lockedBy         User?            @relation("BlueprintLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  sections         BlueprintSection[]
  rules            BlueprintRule[]
  mockTests        MockTest[]

  @@unique([examVersionId, versionNumber])
  @@index([examVersionId])
  @@index([status])
  @@map("exam_blueprints")
}

model BlueprintSection {
  id             String        @id @default(uuid()) @db.VarChar(36)
  blueprintId    String        @map("blueprint_id") @db.VarChar(36)
  name           String        @db.VarChar(150)
  sectionOrder   Int           @map("section_order")
  questionCount  Int           @map("question_count")
  marksPerQuestion Decimal     @map("marks_per_question") @db.Decimal(6, 2)
  totalMarks     Decimal       @map("total_marks") @db.Decimal(8, 2)
  negativeRate   Decimal       @default(0.0) @map("negative_rate") @db.Decimal(5, 4)
  instructions   String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  blueprint      ExamBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, sectionOrder])
  @@index([blueprintId])
  @@map("blueprint_sections")
}

model BlueprintRule {
  id          String        @id @default(uuid()) @db.VarChar(36)
  blueprintId String        @map("blueprint_id") @db.VarChar(36)
  ruleType    String        @map("rule_type") @db.VarChar(100) // e.g., "DIFFICULTY_RATIO", "TOPIC_WEIGHTAGE"
  ruleConfig  Json          @map("rule_config")
  description String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")

  blueprint   ExamBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
  @@map("blueprint_rules")
}

// ==========================================
// 3. SYLLABUS HIERARCHY
// ==========================================

model Syllabus {
  id            String            @id @default(uuid()) @db.VarChar(36)
  examVersionId String            @map("exam_version_id") @db.VarChar(36)
  title         String            @db.VarChar(191)
  isVerified    Boolean           @default(false) @map("is_verified")
  verifiedById  String?           @map("verified_by_id") @db.VarChar(36)
  verifiedAt    DateTime?         @map("verified_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  examVersion   ExamVersion       @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  verifiedBy    User?             @relation("SyllabusVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  sections      SyllabusSection[]

  @@index([examVersionId])
  @@map("syllabi")
}

model SyllabusSection {
  id          String          @id @default(uuid()) @db.VarChar(36)
  syllabusId  String          @map("syllabus_id") @db.VarChar(36)
  name        String          @db.VarChar(191)
  code        String?         @db.VarChar(50)
  description String?         @db.Text
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  syllabus    Syllabus        @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  topics      SyllabusTopic[]

  @@index([syllabusId])
  @@map("syllabus_sections")
}

model SyllabusTopic {
  id          String          @id @default(uuid()) @db.VarChar(36)
  sectionId   String          @map("section_id") @db.VarChar(36)
  name        String          @db.VarChar(191)
  code        String?         @db.VarChar(50)
  description String?         @db.Text
  weightagePercentage Decimal? @map("weightage_percentage") @db.Decimal(5, 2)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  section     SyllabusSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions   Question[]
  topicStats  CandidateTopicStatistic[]
  topicResults TopicResult[]

  @@index([sectionId])
  @@map("syllabus_topics")
}

// ==========================================
// 4. QUESTION BANK & REVIEWS
// ==========================================

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMERICAL
  ASSERTION_REASON
  TRUE_FALSE
  MATCHING
  DESCRIPTIVE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  AI_GENERATED
  AI_VALIDATED
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum QuestionSource {
  MANUAL
  AI_GENERATED
  PREVIOUS_YEAR
  IMPORTED
}

model Question {
  id               String           @id @default(uuid()) @db.VarChar(36)
  topicId          String           @map("topic_id") @db.VarChar(36)
  questionType     QuestionType     @default(SINGLE_CHOICE) @map("question_type")
  difficulty       DifficultyLevel  @default(MEDIUM)
  status           QuestionStatus   @default(DRAFT)
  questionText     String           @map("question_text") @db.Text
  questionTextHindi String?         @map("question_text_hindi") @db.Text
  explanation      String?          @db.Text
  explanationHindi String?          @map("explanation_hindi") @db.Text
  subtopic         String?          @map("subtopic") @db.VarChar(191)
  marks            Decimal          @default(1.0) @map("marks") @db.Decimal(5, 2)
  negativeMarks    Decimal          @default(0.0) @map("negative_marks") @db.Decimal(5, 4)
  source           QuestionSource   @default(MANUAL) @map("source")
  sourceReference  String?          @map("source_reference") @db.Text
  isPreviousYear   Boolean          @default(false) @map("is_previous_year")
  pyqYear          Int?             @map("pyq_year")
  isAiGenerated    Boolean          @default(false) @map("is_ai_generated")
  isAiValidated    Boolean          @default(false) @map("is_ai_validated")
  isHumanVerified  Boolean          @default(false) @map("is_human_verified")
  sourceType       String?          @map("source_type") @db.VarChar(50) // PDF, DOCX, IMAGE, TEXT, MANUAL
  sourceFileName   String?          @map("source_file_name") @db.VarChar(255)
  sourcePage       Int?             @map("source_page")
  sourceTextSnippet String?         @map("source_text_snippet") @db.Text
  generationMode   String?          @map("generation_mode") @db.VarChar(50) // SOURCE_ONLY, EXAM_CONTEXT_ASSISTED
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  topic            SyllabusTopic    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  options          QuestionOption[]
  translations     QuestionTranslation[]
  aiGenerations    QuestionAiGeneration[]
  reviews          QuestionReview[]
  mockTestQuestions MockTestQuestion[]
  testAnswers      TestAnswer[]
  statistics       QuestionStatistic?
  questionResults  QuestionResult[]

  @@index([topicId])
  @@index([status])
  @@index([difficulty])
  @@index([source])
  @@map("questions")
}

model QuestionTranslation {
  id           String   @id @default(uuid()) @db.VarChar(36)
  questionId   String   @map("question_id") @db.VarChar(36)
  language     String   @db.VarChar(10) // "hi", "en", "ta", "te", etc.
  questionText String   @map("question_text") @db.Text
  explanation  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language])
  @@index([questionId])
  @@map("question_translations")
}

model QuestionOption {
  id           String      @id @default(uuid()) @db.VarChar(36)
  questionId   String      @map("question_id") @db.VarChar(36)
  optionKey    String      @map("option_key") @db.VarChar(10) // "A", "B", "C", "D"
  optionText   String      @map("option_text") @db.Text
  optionTextHindi String?  @map("option_text_hindi") @db.Text
  isCorrect    Boolean     @default(false) @map("is_correct")
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")

  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations QuestionOptionTranslation[]
  selectedInAnswers TestAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model QuestionOptionTranslation {
  id         String         @id @default(uuid()) @db.VarChar(36)
  optionId   String         @map("option_id") @db.VarChar(36)
  language   String         @db.VarChar(10) // "hi", "en", etc.
  optionText String         @map("option_text") @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  option     QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, language])
  @@index([optionId])
  @@map("question_option_translations")
}

model QuestionAiGeneration {
  id            String      @id @default(uuid()) @db.VarChar(36)
  questionId    String      @map("question_id") @db.VarChar(36)
  promptUsed    String      @map("prompt_used") @db.Text
  modelName     String      @map("model_name") @db.VarChar(100)
  rawResponse   Json        @map("raw_response")
  tokensUsed    Int?        @map("tokens_used")
  validationStatus String   @map("validation_status") @db.VarChar(50)
  createdAt     DateTime    @default(now()) @map("created_at")

  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_ai_generations")
}

enum ReviewDecision {
  APPROVED
  REJECTED
  NEEDS_REVISION
}

model QuestionReview {
  id          String         @id @default(uuid()) @db.VarChar(36)
  questionId  String         @map("question_id") @db.VarChar(36)
  reviewerId  String         @map("reviewer_id") @db.VarChar(36)
  decision    ReviewDecision
  feedback    String?        @db.Text
  reviewedAt  DateTime       @default(now()) @map("reviewed_at")

  question    Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewer    User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@index([reviewerId])
  @@map("question_reviews")
}

// ==========================================
// 5. MOCK TESTS & VALIDATION ENGINE
// ==========================================

enum MockTestType {
  FULL_MOCK
  TOPIC_PRACTICE
  SECTIONAL_MOCK
  PREVIOUS_YEAR
  AI_PRACTICE
}

enum MockPublishStatus {
  DRAFT
  GENERATING
  VALIDATED
  VALIDATION_FAILED
  PUBLISHED
  ARCHIVED
}

model MockTest {
  id              String            @id @default(uuid()) @db.VarChar(36)
  code            String            @unique @db.VarChar(50) // e.g., "UPHO-2026-MOCK-001"
  examVersionId   String            @map("exam_version_id") @db.VarChar(36)
  blueprintId     String?           @map("blueprint_id") @db.VarChar(36)
  type            MockTestType      @default(FULL_MOCK)
  sequence        Int               @default(1)
  title           String            @db.VarChar(191)
  slug            String            @unique @db.VarChar(150)
  description     String?           @db.Text
  durationMinutes Int               @map("duration_minutes")
  totalQuestions  Int               @map("total_questions")
  totalMarks      Decimal           @map("total_marks") @db.Decimal(8, 2)
  negativeRate    Decimal           @default(0.0) @map("negative_rate") @db.Decimal(5, 4)
  difficulty      DifficultyLevel   @default(MEDIUM)
  language        String            @default("BILINGUAL") @db.VarChar(20) // ENGLISH, HINDI, BILINGUAL
  generationType  String            @default("BLUEPRINT") @map("generation_type") @db.VarChar(50) // BLUEPRINT, SOURCE_BASED, TOPIC_PRACTICE, AI_GENERATED
  createdById     String?           @map("created_by_id") @db.VarChar(36)
  instructions    String?           @db.Text
  instructionsHindi String?         @map("instructions_hindi") @db.Text
  status          MockPublishStatus @default(DRAFT)
  publishedAt     DateTime?         @map("published_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  examVersion     ExamVersion       @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  blueprint       ExamBlueprint?    @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("MockTestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sections        MockTestSection[]
  questions       MockTestQuestion[]
  generationRequests MockGenerationRequest[]
  validationResults MockValidationResult[]
  attempts        TestAttempt[]

  @@index([examVersionId])
  @@index([blueprintId])
  @@index([status])
  @@index([code])
  @@map("mock_tests")
}

model MockTestSection {
  id              String             @id @default(uuid()) @db.VarChar(36)
  mockTestId      String             @map("mock_test_id") @db.VarChar(36)
  name            String             @db.VarChar(150)
  sectionOrder    Int                @map("section_order")
  questionCount   Int                @map("question_count")
  marksPerQuestion Decimal           @map("marks_per_question") @db.Decimal(6, 2)
  negativeRate    Decimal            @default(0.0) @map("negative_rate") @db.Decimal(5, 4)
  createdAt       DateTime           @default(now()) @map("created_at")

  mockTest        MockTest           @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questions       MockTestQuestion[]
  sectionResults  SectionResult[]

  @@unique([mockTestId, sectionOrder])
  @@index([mockTestId])
  @@map("mock_test_sections")
}

model MockTestQuestion {
  id                String          @id @default(uuid()) @db.VarChar(36)
  mockTestId        String          @map("mock_test_id") @db.VarChar(36)
  mockTestSectionId String          @map("mock_test_section_id") @db.VarChar(36)
  questionId        String          @map("question_id") @db.VarChar(36)
  questionOrder     Int             @map("question_order")
  marks             Decimal         @map("marks") @db.Decimal(6, 2)
  negativeMarks     Decimal         @map("negative_marks") @db.Decimal(6, 2)
  createdAt         DateTime        @default(now()) @map("created_at")

  mockTest          MockTest        @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  section           MockTestSection @relation(fields: [mockTestSectionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([mockTestId, questionOrder])
  @@index([mockTestId])
  @@index([mockTestSectionId])
  @@index([questionId])
  @@map("mock_test_questions")
}

model MockGenerationRequest {
  id            String           @id @default(uuid()) @db.VarChar(36)
  examVersionId String           @map("exam_version_id") @db.VarChar(36)
  mockTestId    String?          @map("mock_test_id") @db.VarChar(36)
  requestedById String           @map("requested_by_id") @db.VarChar(36)
  status        ProcessingStatus @default(PENDING)
  criteria      Json
  errorMessage  String?          @map("error_message") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  completedAt   DateTime?        @map("completed_at")

  examVersion   ExamVersion      @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  mockTest      MockTest?        @relation(fields: [mockTestId], references: [id], onDelete: SetNull)

  @@index([examVersionId])
  @@index([mockTestId])
  @@index([status])
  @@map("mock_generation_requests")
}

model MockValidationResult {
  id           String      @id @default(uuid()) @db.VarChar(36)
  mockTestId   String      @map("mock_test_id") @db.VarChar(36)
  isValid      Boolean     @map("is_valid")
  scoreReport  Json        @map("score_report") // Detailed check-by-check result
  errorSummary String?     @map("error_summary") @db.Text
  validatedAt  DateTime    @default(now()) @map("validated_at")

