  @@index([mockTestId])
  @@map("mock_validation_results")
}

// ==========================================
// 6. CANDIDATE ATTEMPTS & TRACKING
// ==========================================

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
  TIMED_OUT
  EXPIRED
  CANCELLED
}

model TestAttempt {
  id               String          @id @default(uuid()) @db.VarChar(36)
  candidateId      String          @map("candidate_id") @db.VarChar(36)
  mockTestId       String          @map("mock_test_id") @db.VarChar(36)
  attemptLanguage  String          @default("BILINGUAL") @map("attempt_language") @db.VarChar(20) // ENGLISH, HINDI, BILINGUAL
  instructionsAcknowledgedAt DateTime? @map("instructions_acknowledged_at")
  instructionsLanguage String?     @map("instructions_language") @db.VarChar(10)
  status           AttemptStatus   @default(IN_PROGRESS)
  startedAt        DateTime        @default(now()) @map("started_at")
  submittedAt      DateTime?       @map("submitted_at")
  totalTimeSpentSeconds Int        @default(0) @map("total_time_spent_seconds")
  lastHeartbeatAt  DateTime        @default(now()) @map("last_heartbeat_at")
  ipAddress        String?         @map("ip_address") @db.VarChar(100)
  userAgent        String?         @map("user_agent") @db.VarChar(255)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  candidate        User            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  mockTest         MockTest        @relation(fields: [mockTestId], references: [id], onDelete: Restrict)
  answers          TestAnswer[]
  answerEvents     AnswerEvent[]
  attemptEvents    AttemptEvent[]
  testResult       TestResult?

  @@index([candidateId])
  @@index([mockTestId])
  @@index([status])
  @@map("test_attempts")
}

model TestAnswer {
  id               String          @id @default(uuid()) @db.VarChar(36)
  attemptId        String          @map("attempt_id") @db.VarChar(36)
  questionId       String          @map("question_id") @db.VarChar(36)
  selectedOptionId String?         @map("selected_option_id") @db.VarChar(36)
  numericalAnswer  Decimal?        @map("numerical_answer") @db.Decimal(10, 4)
  isMarkedForReview Boolean        @default(false) @map("is_marked_for_review")
  isVisited        Boolean         @default(false) @map("is_visited")
  isAnswered       Boolean         @default(false) @map("is_answered")
  timeSpentSeconds Int             @default(0) @map("time_spent_seconds")
  changeCount      Int             @default(0) @map("change_count")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  attempt          TestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("test_answers")
}

model AnswerEvent {
  id            String      @id @default(uuid()) @db.VarChar(36)
  attemptId     String      @map("attempt_id") @db.VarChar(36)
  questionId    String      @map("question_id") @db.VarChar(36)
  eventType     String      @map("event_type") @db.VarChar(50) // e.g., "SELECT_ANSWER", "CLEAR_ANSWER", "MARK_REVIEW", "UNMARK_REVIEW"
  previousValue Json?       @map("previous_value")
  newValue      Json?       @map("new_value")
  timeOffsetMs  Int         @map("time_offset_ms")
  createdAt     DateTime    @default(now()) @map("created_at")

  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("answer_events")
}

model AttemptEvent {
  id           String      @id @default(uuid()) @db.VarChar(36)
  attemptId    String      @map("attempt_id") @db.VarChar(36)
  eventType    String      @map("event_type") @db.VarChar(50) // e.g., "START", "SWITCH_SECTION", "PAUSE", "RESUME", "SUBMIT", "AUTO_SUBMIT"
  eventData    Json?       @map("event_data")
  timeOffsetMs Int         @map("time_offset_ms")
  createdAt    DateTime    @default(now()) @map("created_at")

  attempt      TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("attempt_events")
}

// ==========================================
// 7. RESULTS & ANALYTICS
// ==========================================

model TestResult {
  id               String          @id @default(uuid()) @db.VarChar(36)
  attemptId        String          @unique @map("attempt_id") @db.VarChar(36)
  totalQuestions   Int             @map("total_questions")
  attemptedQuestions Int           @map("attempted_questions")
  correctAnswers   Int             @map("correct_answers")
  incorrectAnswers Int             @map("incorrect_answers")
  unattemptedQuestions Int         @map("unattempted_questions")
  rawScore         Decimal         @map("raw_score") @db.Decimal(8, 2)
  penaltyDeduction Decimal         @map("penalty_deduction") @db.Decimal(8, 2)
  netScore         Decimal         @map("net_score") @db.Decimal(8, 2)
  totalMarks       Decimal         @map("total_marks") @db.Decimal(8, 2)
  percentage       Decimal         @map("percentage") @db.Decimal(5, 2)
  percentile       Decimal?        @db.Decimal(5, 2)
  rank             Int?
  accuracyRate     Decimal         @map("accuracy_rate") @db.Decimal(5, 2)
  geminiFeedback   String?         @map("gemini_feedback") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")

  attempt          TestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionResults   SectionResult[]
  topicResults     TopicResult[]
  questionResults  QuestionResult[]

  @@index([netScore])
  @@map("test_results")
}

model SectionResult {
  id              String          @id @default(uuid()) @db.VarChar(36)
  testResultId    String          @map("test_result_id") @db.VarChar(36)
  mockSectionId   String          @map("mock_section_id") @db.VarChar(36)
  sectionName     String          @map("section_name") @db.VarChar(150)
  totalQuestions  Int             @map("total_questions")
  attempted       Int
  correct         Int
  incorrect       Int
  score           Decimal         @db.Decimal(8, 2)
  totalMarks      Decimal         @map("total_marks") @db.Decimal(8, 2)
  accuracy        Decimal         @db.Decimal(5, 2)
  timeSpentSeconds Int            @map("time_spent_seconds")
  createdAt       DateTime        @default(now()) @map("created_at")

  testResult      TestResult      @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  mockSection     MockTestSection @relation(fields: [mockSectionId], references: [id], onDelete: Cascade)

  @@index([testResultId])
  @@map("section_results")
}

model TopicResult {
  id             String        @id @default(uuid()) @db.VarChar(36)
  testResultId   String        @map("test_result_id") @db.VarChar(36)
  topicId        String        @map("topic_id") @db.VarChar(36)
  topicName      String        @map("topic_name") @db.VarChar(191)
  totalQuestions Int           @map("total_questions")
  attempted      Int
  correct        Int
  incorrect      Int
  accuracy       Decimal       @db.Decimal(5, 2)
  timeSpentSeconds Int         @map("time_spent_seconds")
  createdAt      DateTime      @default(now()) @map("created_at")

  testResult     TestResult    @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  topic          SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([testResultId])
  @@index([topicId])
  @@map("topic_results")
}

model QuestionResult {
  id               String      @id @default(uuid()) @db.VarChar(36)
  testResultId     String      @map("test_result_id") @db.VarChar(36)
  questionId       String      @map("question_id") @db.VarChar(36)
  selectedOptionId String?     @map("selected_option_id") @db.VarChar(36)
  selectedOptionKey String?    @map("selected_option_key") @db.VarChar(10)
  correctOptionKey String?     @map("correct_option_key") @db.VarChar(10)
  isAttempted      Boolean     @map("is_attempted")
  isCorrect        Boolean     @map("is_correct")
  isMarkedForReview Boolean    @default(false) @map("is_marked_for_review")
  marksAwarded     Decimal     @map("marks_awarded") @db.Decimal(6, 2)
  timeSpentSeconds Int         @map("time_spent_seconds")
  createdAt        DateTime    @default(now()) @map("created_at")

  testResult       TestResult  @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([testResultId])
  @@index([questionId])
  @@map("question_results")
}

model CandidateExamStatistic {
  id              String      @id @default(uuid()) @db.VarChar(36)
  candidateId     String      @map("candidate_id") @db.VarChar(36)
  examVersionId   String      @map("exam_version_id") @db.VarChar(36)
  attemptsCount   Int         @default(0) @map("attempts_count")
  bestScore       Decimal     @default(0.0) @map("best_score") @db.Decimal(8, 2)
  averageScore    Decimal     @default(0.0) @map("average_score") @db.Decimal(8, 2)
  averageAccuracy Decimal     @default(0.0) @map("average_accuracy") @db.Decimal(5, 2)
  updatedAt       DateTime    @updatedAt @map("updated_at")

  candidate       User        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  examVersion     ExamVersion @relation(fields: [examVersionId], references: [id], onDelete: Cascade)

  @@unique([candidateId, examVersionId])
  @@index([candidateId])
  @@map("candidate_exam_statistics")
}

model CandidateTopicStatistic {
  id              String        @id @default(uuid()) @db.VarChar(36)
  candidateId     String        @map("candidate_id") @db.VarChar(36)
  topicId         String        @map("topic_id") @db.VarChar(36)
  questionsSeen   Int           @default(0) @map("questions_seen")
  questionsCorrect Int          @default(0) @map("questions_correct")
  accuracyRate    Decimal       @default(0.0) @map("accuracy_rate") @db.Decimal(5, 2)
  isWeakTopic     Boolean       @default(false) @map("is_weak_topic")
  isStrongTopic   Boolean       @default(false) @map("is_strong_topic")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  candidate       User          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic           SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([candidateId, topicId])
  @@index([candidateId])
  @@index([isWeakTopic])
  @@map("candidate_topic_statistics")
}

model QuestionStatistic {
  id              String   @id @default(uuid()) @db.VarChar(36)
  questionId      String   @unique @map("question_id") @db.VarChar(36)
  totalAttempts   Int      @default(0) @map("total_attempts")
  correctAttempts Int      @default(0) @map("correct_attempts")
  avgTimeSeconds  Decimal  @default(0.0) @map("avg_time_seconds") @db.Decimal(6, 2)
  discriminationIndex Decimal? @map("discrimination_index") @db.Decimal(4, 3)
  updatedAt       DateTime @updatedAt @map("updated_at")

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_statistics")
}

// ==========================================
// 8. STORAGE & AUDITING
