# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Output & Cache
/.next/
/out/
build/
dist/

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets (NEVER commit real credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
*.env
*.env.*
!.env.example

# Local File Storage & Private Uploads
/storage/private/*
!/storage/private/.gitkeep
!/storage/private/**/.gitkeep
/storage/public/avatars/*
!/storage/public/avatars/.gitkeep
/storage/*
!/storage/
/uploads/
/temp/
/tmp/
tmp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database Backups & Temporary DB Files
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.sql
!prisma/migrations/**/*.sql
!prisma/migrations/*.sql
/storage/private/backups/*
!/storage/private/backups/.gitkeep

# Testing & Coverage Reports
/coverage
/playwright-report
/test-results
/blob-report

# OS Generated Files
.DS_Store
*.pem
Thumbs.db

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
